# PatchPilot API service (FastAPI on uvicorn).
#
# Phase 0: builds against stub code; serves /healthz and 501 for /score, /rank.
# Phase 4: real model loaded from the bind-mounted .mlruns directory.

FROM python:3.11-slim-bookworm AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:/root/.local/bin:$PATH"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential libgomp1 ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY README.md ./
COPY src ./src

RUN uv sync --frozen --no-dev --no-install-project

COPY flows ./flows
COPY apps ./apps
COPY config ./config

RUN uv sync --frozen --no-dev

ENV PYTHONPATH=/app/src
EXPOSE 8000

CMD ["uvicorn", "patchpilot.serve.api:app", "--host", "0.0.0.0", "--port", "8000"]
